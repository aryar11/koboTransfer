# Copy to .env and adjust. Never commit .env.

# Host path mounted at /data (TrueNAS dataset). Must be writable by APP_UID:APP_GID.
DATA_PATH=/mnt/tank/apps/kobosend
APP_UID=568
APP_GID=568
HOST_BIND=127.0.0.1
HOST_PORT=8080

# How long a code (and its file) lives. Each upload resets the clock.
ROOM_TTL_HOURS=24

# Keep your reverse proxy's body limit (e.g. nginx client_max_body_size) above this.
MAX_UPLOAD_MB=80

ALLOWED_EXTENSIONS=.epub,.pdf,.kepub.epub

# Remove the file after the first complete download.
DELETE_AFTER_DOWNLOAD=false

# Code lookups / downloads allowed per client IP per minute. 0 disables.
LOOKUP_RATE_LIMIT_PER_MIN=30

CLEANUP_INTERVAL_SECONDS=300

# Set true when the site is only served over HTTPS.
COOKIE_SECURE=true

# IPs/CIDRs whose X-Forwarded-For header is trusted (your reverse proxy).
# Leaving the default means all clients share one rate-limit bucket. Avoid "*"
# unless the container is unreachable except through the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
